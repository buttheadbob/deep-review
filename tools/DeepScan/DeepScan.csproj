<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loader-faithful Roslyn compiler and analyzer host for Space Engineers plugin reviews.
       Built by deep_tools.py into tools/cache/deepscan/<source hash>/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);RS1035</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The hub compiler (magnetar Pulsar/Compiler) uses Microsoft.CodeAnalysis.CSharp 5.0.0 with LanguageVersion.CSharp14.
         A newer Roslyn parses and binds C# 14 the same way; analyzers built against older Roslyn load in it. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <!-- Some analyzer assemblies reference Workspaces types; having it in the host avoids load failures. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <!-- The loader publicizes assemblies named in [IgnoresAccessChecksTo] with Mono.Cecil; so does DeepScan. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
