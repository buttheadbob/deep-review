dotnet_diagnostic.RCS1003.severity = none # reason: braces on if-else: formatting
dotnet_diagnostic.RCS1018.severity = none # reason: accessibility modifiers: style
dotnet_diagnostic.RCS1021.severity = none # reason: lambda body shape: style
dotnet_diagnostic.RCS1037.severity = none # reason: trailing whitespace: formatting
dotnet_diagnostic.RCS1049.severity = none # reason: boolean comparison: style
dotnet_diagnostic.RCS1061.severity = none # reason: merge nested if: style
dotnet_diagnostic.RCS1073.severity = none # reason: if to return: style
dotnet_diagnostic.RCS1085.severity = none # reason: auto-property: style
dotnet_diagnostic.RCS1090.severity = none # reason: ConfigureAwait: same as CA2007
dotnet_diagnostic.RCS1102.severity = none # reason: make class static: style
dotnet_diagnostic.RCS1112.severity = none # reason: combine Where calls: style
dotnet_diagnostic.RCS1123.severity = none # reason: parentheses for clarity: formatting
dotnet_diagnostic.RCS1124.severity = none # reason: inline local: style
dotnet_diagnostic.RCS1129.severity = none # reason: redundant field initialisation: style
dotnet_diagnostic.RCS1136.severity = none # reason: merge switch sections: style
dotnet_diagnostic.RCS1139.severity = none # reason: summary element: documentation
dotnet_diagnostic.RCS1140.severity = none # reason: exception documentation: documentation
dotnet_diagnostic.RCS1141.severity = none # reason: param documentation: documentation
dotnet_diagnostic.RCS1142.severity = none # reason: typeparam documentation: documentation
dotnet_diagnostic.RCS1146.severity = none # reason: conditional access: style
dotnet_diagnostic.RCS1161.severity = none # reason: enum explicit values: style
dotnet_diagnostic.RCS1163.severity = none # reason: unused parameter: event handlers and Harmony patches need fixed signatures (S1172 is off for the same reason)
dotnet_diagnostic.RCS1169.severity = none # reason: make field read-only: style
dotnet_diagnostic.RCS1170.severity = none # reason: read-only auto-property: style
dotnet_diagnostic.RCS1181.severity = none # reason: comment placement: formatting
dotnet_diagnostic.RCS1186.severity = none # reason: Regex instance vs static: style
dotnet_diagnostic.RCS1189.severity = none # reason: region directives: formatting
dotnet_diagnostic.RCS1194.severity = none # reason: exception constructors: style
dotnet_diagnostic.RCS1197.severity = none # reason: StringBuilder call shape: style
dotnet_diagnostic.RCS1201.severity = none # reason: method chaining: style
dotnet_diagnostic.RCS1226.severity = none # reason: documentation paragraphs: documentation
dotnet_diagnostic.RCS1231.severity = none # reason: ref read-only parameters: style
dotnet_diagnostic.RCS1234.severity = none # reason: duplicate enum values: style (CA1069 stays on for real duplicates)
dotnet_diagnostic.RCS1240.severity = none # reason: unnecessary operator: style
dotnet_diagnostic.RCS1241.severity = none # reason: IComparable implementation: API design
dotnet_diagnostic.RCS1246.severity = none # reason: element access instead of First(): style
dotnet_diagnostic.RCS1251.severity = none # reason: braces on record declarations: formatting

# ======================================================================== Sonar (S): taste rules outside the smell categories
dotnet_diagnostic.S101.severity = none # reason: naming: type names
dotnet_diagnostic.S107.severity = none # reason: parameter count: metric
dotnet_diagnostic.S1066.severity = none # reason: merge nested if: style
dotnet_diagnostic.S1104.severity = none # reason: public fields: XML-serialised configs use fields
dotnet_diagnostic.S1118.severity = none # reason: utility class constructors: style
dotnet_diagnostic.S1135.severity = none # reason: TODO comments: duplicate of the release check, which counts them
dotnet_diagnostic.S1172.severity = none # reason: unused parameter: event handlers and Harmony patches need fixed signatures
dotnet_diagnostic.S1192.severity = none # reason: duplicated string literals: style
dotnet_diagnostic.S125.severity = none # reason: commented-out code: style
dotnet_diagnostic.S138.severity = none # reason: method length: metric
dotnet_diagnostic.S1450.severity = none # reason: field could be local: style
dotnet_diagnostic.S1541.severity = none # reason: complexity: metric
dotnet_diagnostic.S2245.severity = none # reason: weak random: game randomness is not security (same as CA5394)
dotnet_diagnostic.S2325.severity = none # reason: make member static: style
dotnet_diagnostic.S3011.severity = none # reason: reflection past private does not apply to SE plugins as a defect: they must reach game internals with no public API (the user, 2026-11-17: exempt for all tests); reflection targets are checked against the decompiled game instead
dotnet_diagnostic.S3242.severity = none # reason: parameter type could be more general: API design
dotnet_diagnostic.S3267.severity = none # reason: loops to LINQ: style (LINQ allocates on hot paths)
dotnet_diagnostic.S3358.severity = none # reason: nested ternaries: style
dotnet_diagnostic.S3776.severity = none # reason: cognitive complexity: metric
dotnet_diagnostic.S4136.severity = none # reason: overload ordering: style
dotnet_diagnostic.S4144.severity = none # reason: identical method bodies: style
dotnet_diagnostic.S9422.severity = none # reason: System.Threading.Lock does not exist on net48

# ======================================================================== SecurityCodeScan
dotnet_diagnostic.SCS0005.severity = none # reason: weak random: game randomness is not security (same as CA5394)

# ======================================================================== IDisposableAnalyzers
dotnet_diagnostic.IDISP017.severity = none # reason: prefer using over Dispose(): disposal style only
dotnet_diagnostic.IDISP020.severity = none # reason: SuppressFinalize(this) shape: style
dotnet_diagnostic.IDISP021.severity = none # reason: Dispose(true) shape: style
dotnet_diagnostic.IDISP022.severity = none # reason: Dispose(false) shape: style
dotnet_diagnostic.IDISP023.severity = none # reason: finalizer member access shape: style
dotnet_diagnostic.IDISP025.severity = none # reason: sealed class disposal shape: style

# ======================================================================== VS threading: rules about Visual Studio's main thread
dotnet_diagnostic.VSTHRD001.severity = none # reason: JoinableTaskFactory.SwitchToMainThreadAsync: Visual Studio only; the game thread queue is checked by DeepRules
dotnet_diagnostic.VSTHRD004.severity = none # reason: await SwitchToMainThreadAsync: Visual Studio only
dotnet_diagnostic.VSTHRD010.severity = none # reason: VS main-thread affinity: Visual Studio only
dotnet_diagnostic.VSTHRD012.severity = none # reason: JoinableTaskFactory overloads: Visual Studio only
dotnet_diagnostic.VSTHRD108.severity = none # reason: thread affinity assertions: Visual Studio only
dotnet_diagnostic.VSTHRD111.severity = none # reason: ConfigureAwait(bool): same as CA2007
dotnet_diagnostic.VSTHRD200.severity = none # reason: Async suffix: naming

