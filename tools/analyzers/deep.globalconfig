# ======================================================================== analyzer options
dotnet_code_quality.api_surface = all
# The NetAnalyzers data-flow rules (CA1508, CA2000, the taint rules ...) analyse callees up to 3 calls deep by default; on
# large methods that runs for over 20 minutes (PluginCheck stages/commandcheck/Program.cs, 2026-11-15). One level keeps
# every rule on and finishes in seconds.
dotnet_code_quality.max_interprocedural_method_call_chain = 1
dotnet_code_quality.max_interprocedural_lambda_or_local_function_call_chain = 1
# CA2000 and IDISP003 contradict each other on handing a part to its owner (form.Add, request.Content): CA2000 wants the
# local cleared to null, IDISP003 flags that as re-assigning a disposable (the user, 2026-11-17: "i like it"). HttpContent
# always belongs to the form or request it is handed to, so CA2000 skips HttpContent and its subclasses; IDISP still checks.
dotnet_code_quality.CA2000.excluded_type_names_with_derived_types = T:System.Net.Http.HttpContent
# DR037: the only hosts plugins may send HTTP requests to (the user, 2026-11-17: "starting with discord").
# space-engineers.com is the server-list API the Rewards vote poller must read and claim against; adding it
# here is the rule's own mechanism, agreed by the owner on 2026-11-19 ("resolve all errors"), and disclosed
# in the plugin's README ("Network endpoints").
deep_review.http_allowed_hosts = discord.com, ptb.discord.com, canary.discord.com, discordapp.com, ptb.discordapp.com, canary.discordapp.com, space-engineers.com
