# Deep review analyzer configuration (Space Engineers plugins and the user's other .NET projects).
#
# This file is the ONLY place a rule may be turned off. It is part of toolsVersion, so the rule set is fixed and the same
# for every project. Every line that turns a rule off carries "# reason:". Allowed reasons: pure style, naming, formatting
# or documentation; rules that contradict another rule we keep; rules that do not apply to SE plugins (for example APIs
# that do not exist on .NET Framework 4.8, which every Legacy/Torch plugin must also compile for).
# analyzers/RULESET.md is generated from this file (python deep_tools.py --ruleset).
#
# Every analyzer rule that is enabled by default becomes a warning. Useful rules that ship disabled by default are turned
# on explicitly at the bottom (the bulk key only reaches rules enabled by default).
# DeepScan reads this file itself (keys may contain spaces there); the csproj build passes it to the compiler, which
# ignores the few keys it cannot parse.
is_global = true
global_level = 100

dotnet_analyzer_diagnostic.severity = warning

# ======================================================================== whole categories
dotnet_analyzer_diagnostic.category-Style.severity = none # reason: style category: code shape only, never a defect
dotnet_analyzer_diagnostic.category-Naming.severity = none # reason: naming category: names only, never a defect
dotnet_analyzer_diagnostic.category-Documentation.severity = none # reason: documentation-comment rules: docs, not behaviour
dotnet_analyzer_diagnostic.category-Formatting.severity = none # reason: formatting category: whitespace and layout only
dotnet_analyzer_diagnostic.category-Readability.severity = none # reason: readability category: style only
dotnet_analyzer_diagnostic.category-Layout.severity = none # reason: layout category: formatting only
dotnet_analyzer_diagnostic.category-Ordering.severity = none # reason: member ordering: style only
dotnet_analyzer_diagnostic.category-Spacing.severity = none # reason: spacing: formatting only
dotnet_analyzer_diagnostic.category-Info Code Smell.severity = none # reason: Sonar informational smells: style (Sonar rules that find defects are turned on by id below)
dotnet_analyzer_diagnostic.category-Minor Code Smell.severity = none # reason: Sonar minor smells: style and taste (defect-finding ones are turned on by id below)

# ======================================================================== NetAnalyzers (CA)
dotnet_diagnostic.CA1002.severity = none # reason: API design (List<T> in public API): plugins are not reusable libraries
dotnet_diagnostic.CA1003.severity = none # reason: API design (EventHandler<T> signatures): game and Torch events use their own delegates
dotnet_diagnostic.CA1005.severity = none # reason: API design (generic parameter count): taste
dotnet_diagnostic.CA1008.severity = none # reason: API design (enum zero value): config enums map to fixed saved values
dotnet_diagnostic.CA1010.severity = none # reason: API design (generic collection interfaces): taste
dotnet_diagnostic.CA1012.severity = none # reason: API design (abstract constructors): style
dotnet_diagnostic.CA1014.severity = none # reason: CLSCompliant attribute: not applicable to plugins
dotnet_diagnostic.CA1016.severity = none # reason: assembly version attribute: covered by the release consistency check
dotnet_diagnostic.CA1017.severity = none # reason: ComVisible attribute: not applicable to plugins
dotnet_diagnostic.CA1018.severity = none # reason: AttributeUsage on custom attributes: style
dotnet_diagnostic.CA1019.severity = none # reason: attribute argument accessors: style
dotnet_diagnostic.CA1021.severity = none # reason: out parameters: style; game APIs use out parameters
dotnet_diagnostic.CA1024.severity = none # reason: use properties where appropriate: style
dotnet_diagnostic.CA1027.severity = none # reason: Flags attribute on enums: style
dotnet_diagnostic.CA1028.severity = none # reason: enum storage type: saved config enums keep their type
dotnet_diagnostic.CA1030.severity = none # reason: use events where appropriate: style
dotnet_diagnostic.CA1031.severity = none # reason: contradicts DR015 (a catch-all is required at game entry points: Update, handlers, commands, so one exception does not stop the server); catches that hide errors are found by EPC12/ERP022/RCS1075
dotnet_diagnostic.CA1032.severity = none # reason: standard exception constructors: style
dotnet_diagnostic.CA1033.severity = none # reason: interface methods callable by child types: API design for libraries
dotnet_diagnostic.CA1034.severity = none # reason: nested visible types: style
dotnet_diagnostic.CA1036.severity = none # reason: comparison operators with IComparable: API design
dotnet_diagnostic.CA1040.severity = none # reason: empty interfaces: style
dotnet_diagnostic.CA1041.severity = none # reason: Obsolete message: documentation
dotnet_diagnostic.CA1043.severity = none # reason: indexer argument types: API design
dotnet_diagnostic.CA1044.severity = none # reason: write-only properties: API design
dotnet_diagnostic.CA1045.severity = none # reason: ref parameters: style; game APIs use ref
dotnet_diagnostic.CA1046.severity = none # reason: equality operator on reference types: API design
dotnet_diagnostic.CA1050.severity = none # reason: types in namespaces: style
dotnet_diagnostic.CA1051.severity = none # reason: visible instance fields: style; XML-serialised configs and game patterns use fields
dotnet_diagnostic.CA1052.severity = none # reason: static holder types: style
dotnet_diagnostic.CA1054.severity = none # reason: URI parameters as System.Uri: API design
dotnet_diagnostic.CA1055.severity = none # reason: URI return values as System.Uri: API design
dotnet_diagnostic.CA1056.severity = none # reason: URI properties as System.Uri: API design; XML configs store strings
dotnet_diagnostic.CA1060.severity = none # reason: P/Invokes in a NativeMethods class: code organisation only
dotnet_diagnostic.CA1062.severity = none # reason: public argument null checks: plugins are not libraries; nullable warnings cover this where enabled
dotnet_diagnostic.CA1063.severity = none # reason: full Dispose(bool) pattern: style for sealed and finalizer-less types; real disposal bugs are found by CA2213/IDISP*
dotnet_diagnostic.CA1064.severity = none # reason: public exceptions: API design
dotnet_diagnostic.CA1066.severity = none # reason: IEquatable when overriding Equals: API design
dotnet_diagnostic.CA1067.severity = none # reason: override Equals for IEquatable: API design
dotnet_diagnostic.CA1068.severity = none # reason: CancellationToken last: API design
dotnet_diagnostic.CA1303.severity = none # reason: localized strings: plugins log and reply in English
dotnet_diagnostic.CA1501.severity = none # reason: inheritance depth: game and WPF types are deep by design
dotnet_diagnostic.CA1502.severity = none # reason: cyclomatic complexity: metric, not a defect
dotnet_diagnostic.CA1505.severity = none # reason: maintainability index: metric, not a defect
dotnet_diagnostic.CA1506.severity = none # reason: class coupling: metric, not a defect
dotnet_diagnostic.CA1507.severity = none # reason: nameof for parameter names: style
dotnet_diagnostic.CA1510.severity = none # reason: ArgumentNullException.ThrowIfNull does not exist on net48
dotnet_diagnostic.CA1511.severity = none # reason: ArgumentException.ThrowIfNullOrEmpty does not exist on net48
dotnet_diagnostic.CA1512.severity = none # reason: ArgumentOutOfRangeException.ThrowIf* does not exist on net48
dotnet_diagnostic.CA1513.severity = none # reason: ObjectDisposedException.ThrowIf does not exist on net48
dotnet_diagnostic.CA1515.severity = none # reason: make public types internal: plugin types are public on purpose (the loaders find them by reflection)
dotnet_diagnostic.CA1700.severity = none # reason: naming: enum value names
dotnet_diagnostic.CA1707.severity = none # reason: naming: underscores (Harmony patch parameters such as __instance need them)
dotnet_diagnostic.CA1708.severity = none # reason: naming: case-only differences
dotnet_diagnostic.CA1710.severity = none # reason: naming: collection suffixes
dotnet_diagnostic.CA1711.severity = none # reason: naming: reserved suffixes
dotnet_diagnostic.CA1712.severity = none # reason: naming: enum value prefixes
dotnet_diagnostic.CA1714.severity = none # reason: naming: flags enum plurals
dotnet_diagnostic.CA1715.severity = none # reason: naming: interface and type parameter prefixes
dotnet_diagnostic.CA1716.severity = none # reason: naming: reserved keywords
dotnet_diagnostic.CA1717.severity = none # reason: naming: enum plurals
dotnet_diagnostic.CA1720.severity = none # reason: naming: type names in identifiers
dotnet_diagnostic.CA1721.severity = none # reason: naming: property vs method names
dotnet_diagnostic.CA1724.severity = none # reason: naming: type names that match namespaces
dotnet_diagnostic.CA1725.severity = none # reason: naming: parameter names in overrides
dotnet_diagnostic.CA1727.severity = none # reason: naming: logging placeholders
dotnet_diagnostic.CA1805.severity = none # reason: explicit default initialisation: style
dotnet_diagnostic.CA1812.severity = none # reason: uninstantiated internal classes: the loaders and XML serialisers create them by reflection
dotnet_diagnostic.CA1815.severity = none # reason: Equals on value types: API design
dotnet_diagnostic.CA1819.severity = none # reason: array properties: XML-serialised configs use arrays
dotnet_diagnostic.CA1822.severity = none # reason: mark members static: style
dotnet_diagnostic.CA1848.severity = none # reason: LoggerMessage delegates: plugins log through NLog or the PluginSdk, not Microsoft.Extensions.Logging
dotnet_diagnostic.CA1852.severity = none # reason: seal internal types: style-level micro-optimisation
dotnet_diagnostic.CA2007.severity = none # reason: ConfigureAwait: plugin code has no UI SynchronizationContext to capture (the game thread queue is not one); deadlock risks are found by VSTHRD002/VSTHRD103
dotnet_diagnostic.CA2211.severity = none # reason: non-constant static fields visible: plugin singletons (Instance) by design; races are found by S2696 and DeepRules
dotnet_diagnostic.CA2217.severity = none # reason: Flags enum values: style
dotnet_diagnostic.CA2225.severity = none # reason: operator alternates: API design
dotnet_diagnostic.CA2227.severity = none # reason: settable collection properties: XML serialisation needs setters
dotnet_diagnostic.CA2234.severity = none # reason: pass System.Uri instead of string: API design
dotnet_diagnostic.CA2252.severity = none # reason: preview features: not used (LangVersion latest rule)
dotnet_diagnostic.CA2263.severity = none # reason: generic Enum overloads do not exist on net48
dotnet_diagnostic.CA5394.severity = none # reason: insecure randomness: game randomness is not security (crypto rules CA5350/CA5351 stay on)

# ======================================================================== Meziantou (MA)
dotnet_diagnostic.MA0003.severity = none # reason: named boolean arguments: style
dotnet_diagnostic.MA0004.severity = none # reason: ConfigureAwait(false): same as CA2007, no UI context in plugin code
dotnet_diagnostic.MA0006.severity = none # reason: string.Equals instead of ==: == on strings is ordinal already; culture issues are MA0001/CA1307/CA1309
dotnet_diagnostic.MA0007.severity = none # reason: trailing commas: formatting
dotnet_diagnostic.MA0015.severity = none # reason: parameter name in ArgumentException: message quality, not behaviour
dotnet_diagnostic.MA0016.severity = none # reason: prefer collection abstractions: API design
dotnet_diagnostic.MA0025.severity = none # reason: NotImplementedException: covered by the TODO check
dotnet_diagnostic.MA0026.severity = none # reason: TODO comments: duplicate of the release check, which counts them
dotnet_diagnostic.MA0036.severity = none # reason: make class static: style
dotnet_diagnostic.MA0038.severity = none # reason: make method static: style
dotnet_diagnostic.MA0041.severity = none # reason: make property static: style
dotnet_diagnostic.MA0046.severity = none # reason: EventHandler delegate shape: API design
dotnet_diagnostic.MA0047.severity = none # reason: types in namespaces: style
dotnet_diagnostic.MA0048.severity = none # reason: file name matches type name: style
dotnet_diagnostic.MA0051.severity = none # reason: method length: metric, not a defect
dotnet_diagnostic.MA0053.severity = none # reason: seal classes: style
dotnet_diagnostic.MA0069.severity = none # reason: non-constant static fields visible: same as CA2211
dotnet_diagnostic.MA0071.severity = none # reason: avoid redundant else: style
dotnet_diagnostic.MA0097.severity = none # reason: IComparable operators: API design
dotnet_diagnostic.MA0127.severity = none # reason: string.Equals instead of 'is' pattern: style
dotnet_diagnostic.MA0154.severity = none # reason: langword in XML comments: documentation
dotnet_diagnostic.MA0158.severity = none # reason: System.Threading.Lock does not exist on net48
dotnet_diagnostic.MA0184.severity = none # reason: interpolated string without parameters: style

